# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minierpcrm?schema=public"

# JWT Secret for signing authentication tokens
JWT_SECRET="super-secret-jwt-key-minierp-2026-change-in-production"

# Port on which the Express server listens
PORT=5000

# Frontend URL for CORS configuration (comma-separated if multiple)
FRONTEND_URL="http://localhost:5173"

# Node Environment (development | production | test)
NODE_ENV="development"
